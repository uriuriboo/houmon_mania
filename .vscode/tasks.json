    {
      "label": "check: typecheck + lint + test",
      "dependsOrder": "sequence",
      "dependsOn": ["typecheck", "lint", "test: 単体テスト"],
      "problemMatcher": []
    },
    {
      "label": "setup: 依存のインストール(npm ci)",
      "type": "shell",
      "command": "npm ci",
      "problemMatcher": []
