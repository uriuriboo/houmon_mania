      "script": "fixture",
      "args": ["--", "--count", "5000"],
      "problemMatcher": []
    },
    {
      "label": "fixture: 架空データ(展開済みフォルダ, 5000件)",
      "type": "npm",
      "script": "fixture",
      "args": ["--", "--count", "5000", "--folder"],
      "problemMatcher": []
