{
  "name": "visit_mania",
  "version": "0.1.0",
  "private": true,
  "description": "Swarm のチェックイン履歴を、公式エクスポートからブラウザの中だけで検索する Web アプリ(非公式)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-export-segments.mjs && node scripts/inject-csp.mjs",
    "preview": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixture": "node scripts/generate-fixture.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "liqe": "3.8.7",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
